# Biến môi trường mẫu cho hạ tầng PostgreSQL và Apache Superset (Local)
# Sao chép file này thành .env trong thư mục infra/ hoặc gốc repository

# Cấu hình PostgreSQL Database Warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=maintenance_dw
POSTGRES_PORT=5432

# Cấu hình Apache Superset
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=maintenance_predictive_superset_secret_key_2026_super_secure

# Tài khoản quản trị Superset ban đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@predictive-maintenance.local

